# Copy this file to .env and fill in ONE of the following to enable LLM mode.
# Leave everything blank to run in DEMO MODE (rule-based routing, no API key needed).

# Option A: Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Option B: OpenAI
# OPENAI_API_KEY=sk-...

# Option C: Self-hosted vLLM (OpenAI-compatible endpoint), matches the
# proposal's "self-hosted LLM on college GPU" plan
# OPENAI_BASE_URL=http://localhost:8001/v1
# OPENAI_API_KEY=not-needed-for-local-vllm
# LLM_MODEL_NAME=your-vllm-served-model-name
